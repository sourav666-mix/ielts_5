# ==============================================================
# ATLAS IELTS Academy — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ==============================================================

# ── MySQL (Docker Compose builds DATABASE_URL from these) ────
MYSQL_ROOT_PASSWORD=root_secret_change_me
MYSQL_DATABASE=atlas_ielts
MYSQL_USER=atlas
MYSQL_PASSWORD=atlas_secret_change_me
# Only needed when running the backend OUTSIDE Docker:
# DATABASE_URL=mysql+pymysql://atlas:atlas_secret_change_me@localhost:3307/atlas_ielts

# ── Security ──────────────────────────────────────────────────
JWT_SECRET=kX9mW2pR7vTnE4fQ8mZbA5yLcH3jU6dG1sN7oV2xB4tK9rE0wF5qM8aC3iZ6uD1h
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200        # 30 days

# ── AI providers ─────────────────────────────────────────────
# OpenRouter  → https://openrouter.ai/keys   (LLMs + Kokoro TTS + images)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
# Groq        → https://console.groq.com/keys (Whisper STT + overflow LLM)
GROQ_API_KEY=gsk_your-groq-api-key-here

# ── Model routing (spec §12.3 — slugs age fast, re-verify) ───
MODEL_READING_GEN=deepseek/deepseek-v4-flash
MODEL_READING_QA=deepseek/deepseek-v4-flash
MODEL_READING_QA_TARGETED=qwen/qwen3.7-plus
MODEL_READING_INSIGHT=z-ai/glm-5.3-flash
MODEL_LISTENING_GEN=z-ai/glm-5.3-flash
MODEL_LISTENING_QA=deepseek/deepseek-v4-flash
MODEL_WRITING_GEN=google/gemini-3.8-flash
MODEL_WRITING_GRADE=openai/gpt-5.6-luna
MODEL_WRITING_VISION=qwen/qwen3.8-flash
MODEL_SPEAKING_GEN=deepseek/deepseek-v4-flash
MODEL_SPEAKING_FEEDBACK=openai/gpt-5.6-luna
MODEL_FALLBACK=google/gemini-3.6-flash:batch

# ── Voice (spec §13 — Kokoro-82M only, single provider) ──────
TTS_MODEL=hexgrad/kokoro-82m
TTS_COACH_VOICE=af_heart
STT_MODEL=whisper-large-v3-turbo

# ── Task-1 diagram images (spec §14) ─────────────────────────
IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# Frontend build-time override (put in frontend/.env if needed; default /api)
# VITE_API_BASE=/api